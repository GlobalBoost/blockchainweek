{
  "name": "unblockchainweek",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@unblockchainweek/web",
    "build": "turbo run build --filter=@unblockchainweek/web",
    "build:site": "turbo run build:site --filter=@unblockchainweek/web",
    "start": "turbo run start --filter=@unblockchainweek/web",
    "lint": "turbo run lint",
    "sync:wordpress": "turbo run sync:wordpress --filter=@unblockchainweek/web"
  },
  "devDependencies": {
    "turbo": "^2.10.9"
  }
}
