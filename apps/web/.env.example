# WordPress sync (CMS)
WORDPRESS_URL=https://cms.unblockchainweek.com
SYNC_ENABLED=false
SYNC_SPEAKERS=false
SYNC_SPONSORS=false
SYNC_MEDIA_PARTNERS=false
SYNC_BLOG=false
SYNC_FETCH_DELAY_MS=150
SYNC_FETCH_CONCURRENCY=5

# Webhook + cron (set on Vercel; invent strong random values)
# Header for WP → site: x-sync-secret: <SYNC_SECRET>
SYNC_SECRET=
# Vercel Cron Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
# Create under Vercel → Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=

# Public Next.js site
NEXT_PUBLIC_SITE_URL=https://www.blockchainweek.ai

# PostHog (product analytics)
# Create a project at https://us.posthog.com then paste the project token.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Optional. Defaults to the US Cloud ingest host.
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# EU Cloud: NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

